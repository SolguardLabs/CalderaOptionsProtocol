{
    "name": "caldera-options-protocol",
    "version": "1.0.0",
    "private": true,
    "description": "Protocolo Solidity de opciones cubiertas, liquidacion monetaria y gestion de riesgo.",
    "type": "module",
    "scripts": {
        "build:ts": "tsc --noEmit",
        "test:ts": "npm run build:ts && node --import tsx --test \"sdk/*.test.ts\" \"tests/repository/*.test.ts\"",
        "format": "prettier --write \"**/*.{json,md,mjs,ts,yaml,yml}\"",
        "format:check": "prettier --check \"**/*.{json,md,mjs,ts,yaml,yml}\"",
        "verify:repo": "node scripts/verify-repository.mjs"
    },
    "devDependencies": {
        "@types/node": "24.13.3",
        "prettier": "3.9.5",
        "tsx": "4.23.12",
        "typescript": "5.9.3"
    },
    "engines": {
        "bun": ">=1.3.14",
        "node": ">=24"
    }
}
